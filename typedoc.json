{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@liminal-hq/undertone",
  "entryPoints": ["packages/undertone/src/api.ts"],
  "tsconfig": "packages/undertone/tsconfig.json",
  "out": "docs/api",
  "docsRoot": "docs",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "intentionallyNotExported": [
    "GainNodeLike",
    "AudioBufferLike",
    "BiquadFilterNodeLike",
    "AudioBufferSourceNodeLike",
    "AudioNodeLike",
    "ConvolverNodeLike",
    "DelayNodeLike",
    "OscillatorNodeLike",
    "StereoPannerNodeLike",
    "RegisteredSource",
    "AudioParamLike",
    "RandomSource",
    "RenderablePattern"
  ]
}
