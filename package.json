{
  "name": "@liminal-hq/undertone",
  "version": "0.2.0",
  "description": "A small, dependency-free procedural synth engine for game SFX and pattern-based music — Web Audio, mini-notation, euclidean rhythms, zero deps.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck:demo": "tsc -p demo/tsconfig.json",
    "build:demo": "vite build demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "vite demo",
    "docs:api": "typedoc",
    "docs:dev": "bun run docs:api && vitepress dev docs",
    "docs:build": "bun run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "web-audio",
    "sound-effects",
    "synthesizer",
    "procedural-audio",
    "game-development"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liminal-hq/undertone.git"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
