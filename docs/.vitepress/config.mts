import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { withMermaid } from 'vitepress-plugin-mermaid';
import { liveFencePlugin } from './theme/live/liveFence';

// Generated by `bun run docs:api` (typedoc + typedoc-vitepress-theme) before
// this config loads — docs:dev/docs:build always run docs:api first.
const typedocSidebarPath = fileURLToPath(new URL('../api/typedoc-sidebar.json', import.meta.url));
const typedocSidebar = JSON.parse(readFileSync(typedocSidebarPath, 'utf-8'));

const guideSidebar = [
  {
    text: 'Guide',
    items: [
      { text: 'Getting Started', link: '/guide/getting-started' },
      { text: 'Mini-Notation', link: '/guide/mini-notation' },
      { text: 'Tempo & Note Length', link: '/guide/tempo-and-note-length' },
      { text: 'Melody & Harmony', link: '/guide/melody-and-harmony' },
      { text: 'Samples', link: '/guide/samples' },
      { text: 'Effects & Filters', link: '/guide/effects' },
      { text: 'FM Synthesis', link: '/guide/fm-synthesis' },
      { text: 'Instruments & Scores', link: '/guide/instruments-and-scores' },
      { text: 'Patterned Parameters', link: '/guide/patterned-parameters' },
      { text: 'Signals', link: '/guide/signals' },
      { text: 'Arranging Songs', link: '/guide/arranging-songs' },
      { text: 'Stereo & Surround', link: '/guide/stereo-and-surround' },
      { text: 'Rendering & Export', link: '/guide/rendering-and-export' },
      { text: 'Runtimes & Loading', link: '/guide/runtimes' },
      { text: 'Troubleshooting', link: '/guide/troubleshooting' }
    ]
  },
  {
    // Ships with 0.4.0; each page says so. The rustdoc is published beside the site (see gh-pages.yml).
    text: 'Rust (ships with 0.4.0)',
    items: [
      { text: 'Getting Started', link: '/guide/rust-getting-started' },
      { text: 'Mini-Notation', link: '/guide/rust-mini-notation' },
      { text: 'Tempo & Note Length', link: '/guide/rust-tempo-and-note-length' },
      { text: 'Melody & Harmony', link: '/guide/rust-melody-and-harmony' },
      { text: 'Samples', link: '/guide/rust-samples' },
      { text: 'Effects & Filters', link: '/guide/rust-effects' },
      { text: 'FM Synthesis', link: '/guide/rust-fm-synthesis' },
      { text: 'Instruments & Scores', link: '/guide/rust-instruments-and-scores' },
      { text: 'Patterned Parameters', link: '/guide/rust-patterned-parameters' },
      { text: 'Signals', link: '/guide/rust-signals' },
      { text: 'Arranging Songs', link: '/guide/rust-arranging-songs' },
      { text: 'Stereo & Surround', link: '/guide/rust-stereo-and-surround' },
      { text: 'Rendering & Export', link: '/guide/rust-rendering-and-export' },
      { text: 'Playing Natively', link: '/guide/rust-native' },
      { text: 'Troubleshooting', link: '/guide/rust-troubleshooting' },
      { text: 'Rust API reference (rustdoc)', link: '/rust/undertone/', target: '_self' }
    ]
  },
  {
    text: 'More',
    items: [
      { text: 'Recipes', link: '/recipes' },
      { text: 'Coming from Strudel', link: '/coming-from-strudel' }
    ]
  }
];

const base = '/undertone/';

export default withMermaid({
  title: 'undertone',
  description: 'A procedural synth engine for games and music, built on the Web Audio API.',
  base,
  cleanUrls: true,
  // The Rust migration plan lives in the repository but is not part of the published site; public/ holds
  // static files only (rustdoc ships Markdown licence files that must not be built as pages).
  srcExclude: ['rust-migration/**', 'public/**'],
  // The rustdoc is built by cargo and copied to public/rust/ (gh-pages.yml), so its pages are not Markdown
  // pages and the link checker cannot see them; scripts/check-rust-docs.sh checks the links to it.
  ignoreDeadLinks: [/^\/rust\//],
  // Absolute, not `favicon.svg` — a bare relative href resolves against the
  // *current page's* URL, so it'd 404 from anywhere but the site root (the
  // same bug the Playground nav link had).
  head: [['link', { rel: 'icon', type: 'image/svg+xml', href: `${base}favicon.svg` }]],
  // The guide's effects/arrange pages embed Mermaid diagrams as fenced ```mermaid blocks.
  mermaid: {},
  // ```ts live fences become editable, playable examples (theme/live/).
  markdown: {
    config(md) {
      liveFencePlugin(md);
    }
  },
  themeConfig: {
    // The app icon (the same file as the favicon), beside the site title in the header on every page, as on the Rust docs bar.
    logo: { src: '/favicon.svg', alt: 'undertone' },
    nav: [
      { text: 'Guide', link: '/guide/getting-started' },
      { text: 'Recipes', link: '/recipes' },
      { text: 'Coming from Strudel', link: '/coming-from-strudel' },
      { text: 'API', link: '/api/' },
      { text: 'Rust API', link: '/rust/undertone/', target: '_self' },
      { text: 'Playground', link: '/playground' }
    ],
    sidebar: {
      '/guide/': guideSidebar,
      '/recipes': guideSidebar,
      '/coming-from-strudel': guideSidebar,
      '/api/': typedocSidebar
    },
    search: {
      provider: 'local'
    },
    // The dedicated icon slot, rather than a plain nav-text item — shaves one
    // item off the inline text menu (see custom.css's nav-overflow note) and
    // is the idiomatic place for a repo link.
    socialLinks: [{ icon: 'github', link: 'https://github.com/liminal-hq/undertone' }]
  }
});
